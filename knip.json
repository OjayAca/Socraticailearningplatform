{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,ts}",
        "tests/**/*.{mjs,ts,tsx}",
        "*.config.{js,mjs,ts}"
      ]
    },
    "packages/contracts": {
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
