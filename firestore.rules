rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function isAdmin() {
      return activeAccount()
        && request.auth.token.role == "admin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPreferences(value) {
      return value is map
        && value.keys().hasOnly(["liveAlertPopups", "theme", "reducedMotion"])
        && (!value.keys().hasAny(["liveAlertPopups"]) || value.liveAlertPopups is bool)
        && (!value.keys().hasAny(["theme"]) || value.theme in ["light", "dark", "system"])
        && (!value.keys().hasAny(["reducedMotion"]) || value.reducedMotion is bool);
    }

    function validOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "preferences",
          "updatedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 120
        && validPreferences(request.resource.data.preferences)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, delete: if false;
      allow update: if isOwner(userId) && activeAccount() && validOwnProfileUpdate();

      match /consents/{version} {
        allow read: if (isOwner(userId) && activeAccount()) || isAdmin();
        allow write: if false;
      }
    }

    match /subjects/{subjectId} {
      allow get, list: if activeAccount() && (isAdmin() || resource.data.status == "approved");
      allow write: if false;
    }

    match /topics/{topicId} {
      allow get, list: if activeAccount() && (isAdmin() || resource.data.status == "approved");
      allow write: if false;
    }

    match /problems/{problemId} {
      allow get, list: if activeAccount() && (isAdmin() || resource.data.status == "approved");
      allow write: if false;

      match /private/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /formula_theorem_references/{referenceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /socratic_prompt_bank/{promptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /misconception_categories/{categoryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /difficulty_policies/{policyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /content_validation_records/{validationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /policy_documents/{policyId} {
      allow read: if activeAccount() && (isAdmin() || resource.data.status == "active");
      allow write: if false;
    }

    match /sessions/{sessionId} {
      allow get: if activeAccount() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow list: if activeAccount() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;

      match /responses/{responseId} {
        allow read: if activeAccount()
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId == request.auth.uid || isAdmin());
        allow write: if false;
      }

      match /scorecards/{scorecardId} {
        allow read: if activeAccount()
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId == request.auth.uid || isAdmin());
        allow write: if false;
      }

      match /unlock_events/{eventId} {
        allow read: if activeAccount()
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentId == request.auth.uid || isAdmin());
        allow write: if false;
      }

      match /private/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /private_evaluations/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /private_ai/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /learning_progress/{userId} {
      allow read: if (isOwner(userId) && activeAccount()) || isAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if activeAccount() && resource.data.recipientId == request.auth.uid;
      allow create, delete: if false;
      allow update: if activeAccount()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ai_failure_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /idempotency/{documentId} {
      allow read, write: if false;
    }

    match /rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /evaluation_locks/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
