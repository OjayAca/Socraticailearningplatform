# Firebase web configuration (public identifiers, never server credentials)
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Secure Functions and App Check
VITE_FUNCTIONS_REGION=asia-southeast1
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# Functions runtime variables belong in functions/.env.<project-id>:
# FUNCTIONS_REGION=asia-southeast1
# FUNCTIONS_SERVICE_ACCOUNT=mindguide-functions@your-project-id.iam.gserviceaccount.com
# GEMINI_MODEL=gemini-2.5-flash

# Never use a VITE_ prefix for Gemini. Store the credential in Secret Manager:
# firebase functions:secrets:set GEMINI_API_KEY --project your-project-id

# Release-preflight evidence acknowledgements. Set to true only after attaching
# the corresponding project-owner evidence; these are never browser variables.

# Dedicated staging E2E values are shell/CI secrets, not Vite browser variables.
# Never point MINDGUIDE_E2E_BASE_URL at production or the current
# socratic-ai-a7765 project.
# MINDGUIDE_E2E_BASE_URL=https://your-dedicated-staging-host.example
# MINDGUIDE_E2E_STUDENT_EMAIL=staging-student@example.test
# MINDGUIDE_E2E_STUDENT_PASSWORD=use-a-secret-store
# MINDGUIDE_E2E_ADMIN_EMAIL=staging-admin@example.test
# MINDGUIDE_E2E_ADMIN_PASSWORD=use-a-secret-store

# Local dev connects to the real Firebase project configured above.
# Explicit CLI/CI variables (never VITE_):
# MINDGUIDE_TARGET_PROJECT=your-dedicated-staging-project
# MINDGUIDE_STAGING_PROJECT=your-dedicated-staging-project
# MINDGUIDE_DEPLOY_MODE=closed-staging
# MINDGUIDE_OWNER_EVIDENCE=/absolute/path/owner-evidence.json
# MINDGUIDE_OWNER_PUBLIC_KEY=/absolute/path/owner-ed25519-public.pem
# Functions runtime: RELEASE_ARTIFACT_HASH=<verified artifact hash>
