# Firebase web configuration (public identifiers, never server credentials)
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Secure Functions and App Check
VITE_FUNCTIONS_REGION=asia-southeast1
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# Functions runtime variables belong in functions/.env.<project-id>:
# FUNCTIONS_REGION=asia-southeast1
# FUNCTIONS_SERVICE_ACCOUNT=mindguide-functions@your-project-id.iam.gserviceaccount.com
# GEMINI_MODEL=gemini-2.5-flash

# Never use a VITE_ prefix for Gemini. Store the credential in Secret Manager:
# firebase functions:secrets:set GEMINI_API_KEY --project your-project-id
