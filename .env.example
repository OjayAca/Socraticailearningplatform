# Firebase web configuration (public identifiers, never server credentials)
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional App Check public site key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# Public URL of the Free Cloudflare Worker. Never put a Gemini key in a VITE_ variable.
VITE_AI_WORKER_URL=https://mindguide-socratic-tutor.your-subdomain.workers.dev
# GEMINI_API_KEY belongs in Worker secrets or an ignored server-only environment file.
# Operator scripts use firebase login or GOOGLE_APPLICATION_CREDENTIALS outside the browser.

# Dedicated staging E2E values are shell/CI secrets, not Vite browser variables.
# Never point MINDGUIDE_E2E_BASE_URL at production or the current
# socratic-ai-a7765 project.
# MINDGUIDE_E2E_BASE_URL=https://your-dedicated-staging-host.example
# MINDGUIDE_E2E_STUDENT_EMAIL=staging-student@example.test
# MINDGUIDE_E2E_STUDENT_PASSWORD=use-a-secret-store
# MINDGUIDE_E2E_ADMIN_EMAIL=staging-admin@example.test
# MINDGUIDE_E2E_ADMIN_PASSWORD=use-a-secret-store

# Local dev connects to the real Firebase project configured above.
# Explicit CLI/CI variables (never VITE_):
# MINDGUIDE_TARGET_PROJECT=your-dedicated-staging-project
# MINDGUIDE_STAGING_PROJECT=your-dedicated-staging-project
