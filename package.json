{
  "name": "mindguide",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "workspaces": [
    "functions",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build:contracts && npm run build:functions && vite build",
    "build:contracts": "npm run build --workspace @mindguide/contracts",
    "prepare:functions-contracts": "node scripts/prepare-functions-contracts.mjs",
    "build:functions": "npm run prepare:functions-contracts && npm run build --workspace @mindguide/functions",
    "dev": "node scripts/dev-with-functions-emulator.mjs",
    "dev:web": "vite",
    "preview": "vite preview --host localhost --port 4173",
    "typecheck": "npm run build:contracts && npm run prepare:functions-contracts && tsc -p tsconfig.json --noEmit && npm run typecheck --workspace @mindguide/functions",
    "lint": "eslint .",
    "deadcode": "knip --no-config-hints",
    "test": "vitest run && npm run build:contracts && npm run prepare:functions-contracts && npm run test --workspace @mindguide/functions",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project mindguide-test --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run deadcode && npm run test && npm run test:rules && npm run build && npm run scan:bundle && npm run test:e2e",
    "migrate:v2": "node scripts/migrate-v2.mjs",
    "migrate:v3": "node --import tsx scripts/migrate-v3.ts",
    "migrate:v3:verify": "node --import tsx scripts/migrate-v3.ts --verify",
    "migrate:v3:rollback": "node --import tsx scripts/migrate-v3.ts --rollback",
    "migrate:v4": "node --import tsx scripts/migrate-v4.ts",
    "migrate:v4:verify": "node --import tsx scripts/migrate-v4.ts --verify",
    "migrate:v4:rollback": "node --import tsx scripts/migrate-v4.ts --rollback",
    "release:preflight": "node --import tsx scripts/release-preflight.ts",
    "scan:bundle": "node scripts/scan-browser-bundle.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "clsx": "2.1.1",
    "firebase": "^12.16.0",
    "katex": "^0.18.0",
    "lucide-react": "^0.487.0",
    "mathlive": "^0.110.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.23.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "knip": "^6.29.0",
    "tailwindcss": "4.1.12",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
